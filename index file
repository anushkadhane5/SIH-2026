            saveOpportunity: function(e, type) {
                e.preventDefault();
                const user = DB.currentUser;
                const title = document.getElementById('oppTitle').value;
                const domain = document.getElementById('oppDomain').value;
                const comp = document.getElementById('oppComp').value;
                const skills = document.getElementById('oppSkills').value.split(',').map(s => s.trim()).filter(Boolean);

                if (type === 'Internship') {
                    DB.internships.push({
                        id: DB.internships.length + 1,
                        company: user.company || user.name,
                        title,
                        domain,
                        skills,
                        duration: '6 Months',
                        stipend: comp,
                        deadline: '2026-10-31',
                        postedBy: user.id
                    });
                } else {
                    DB.placements.push({
                        id: DB.placements.length + 1,
                        company: user.company || user.name,
                        title,
                        domain,
                        skills,
                        salary: comp,
                        location: 'Pan-India',
                        postedBy: user.id
                    });
                }

                this.showToast(`${type} opening successfully published!`, 'success');
                this.render();
            },

            applyOpportunity: function(type, title) {
                this.showToast(`Application with APAAR ID portfolio submitted for "${title}"!`, 'success');
            },

            showToast: function(message, type = 'info') {
                const colorMap = {
                    success: 'bg-emerald-700 text-white border-emerald-800',
                    error: 'bg-rose-700 text-white border-rose-800',
                    info: 'bg-slate-900 text-amber-300 border-slate-800'
                };
                const toast = document.createElement('div');
                toast.className = `fixed bottom-6 left-6 ${colorMap[type]} px-4 py-3 rounded-xl shadow-2xl border text-xs font-semibold z-50 transition-all duration-300 flex items-center space-x-2`;
                toast.innerHTML = `<i class="fa-solid fa-circle-info"></i><span>${message}</span>`;
                document.body.appendChild(toast);
                setTimeout(() => {
                    toast.style.opacity = '0';
                    setTimeout(() => toast.remove(), 300);
                }, 3500);
            }
        };

        // Boot system when DOM is ready
        document.addEventListener('DOMContentLoaded', () => App.init());
