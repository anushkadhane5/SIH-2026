            saveCourse: function(e) {
                e.preventDefault();
                const user = DB.currentUser;
                const title = document.getElementById('newCourseTitle').value;
                const domain = document.getElementById('newCourseDomain').value;
                const nepCredits = parseInt(document.getElementById('newCourseCredits').value);
                const deadline = document.getElementById('newCourseDeadline').value;
                const description = document.getElementById('newCourseDesc').value;

                const rawQuiz = document.getElementById('newCourseQuiz').value.split('\n').filter(l => l.trim());
                const quiz = rawQuiz.map(line => {
                    const parts = line.split('|');
                    if (parts.length === 3) {
                        return {
                            q: parts[0].trim(),
                            options: parts[1].split(',').map(o => o.trim()),
                            answer: parseInt(parts[2].trim())
                        };
                    }
                    return null;
                }).filter(Boolean);

                const newCourse = {
                    id: DB.courses.length + 1,
                    title,
                    author: user.name,
                    domain,
                    nepCredits,
                    deadline,
                    description,
                    quiz,
                    certified: true
                };

                DB.courses.push(newCourse);
                this.showToast('Course published!', 'success');
                this.render();
            },

            deleteCourse: function(id) {
                DB.courses = DB.courses.filter(c => c.id !== id);
                this.showToast('Course removed.', 'info');
                this.render();
            },

